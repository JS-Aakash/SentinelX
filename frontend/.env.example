# ==============================================================
# SentinelX Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit the .env.local file to Git.
# ==============================================================

# ── Backend API URL ─────────────────────────────────────────────
# In production: your Railway backend URL e.g. https://sentinelx-backend.up.railway.app/api/v1
# In development: http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1

# ── Backend Socket.IO URL ───────────────────────────────────────
# In production: your Railway backend root URL (no /api/v1)
# In development: http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=https://your-backend.up.railway.app
