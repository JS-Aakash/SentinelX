# ==============================================================
# SentinelX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.
# ==============================================================

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database — MongoDB Atlas ────────────────────────────────────
# Free tier: https://cloud.mongodb.com → Create M0 cluster
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sentinelx?retryWrites=true&w=majority

# ── JWT Authentication ──────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Password Reset ──────────────────────────────────────────────
PASSWORD_RESET_SECRET=your_password_reset_secret_key_min_32_chars_long
PASSWORD_RESET_EXPIRES_IN=1h

# ── CORS — Frontend URL ─────────────────────────────────────────
# In production: your Vercel frontend URL e.g. https://sentinelx.vercel.app
# In development: http://localhost:3000
CLIENT_URL=https://your-app.vercel.app

# ── File Upload ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Cloudinary — File Storage ───────────────────────────────────
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── SMTP — Email Service ────────────────────────────────────────
# Use Mailtrap for dev: https://mailtrap.io
# Use SendGrid/Resend for production
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=SentinelX <noreply@sentinelx.com>

# ── MQTT Broker — ESP32 IoT Telemetry ───────────────────────────
# Free cloud broker: https://www.hivemq.com/mqtt-cloud-broker/ (100 connections free)
# Format: mqtts://<your-cluster>.s1.eu.hivemq.cloud:8883
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_CLIENT_ID=sentinelx_backend_ingestion
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password

# ── Python AI Microservice ──────────────────────────────────────
# In production: your Railway Python service URL
# In development: http://localhost:8000
PYTHON_AI_SERVICE_URL=http://localhost:8000

# ── Ethereum Sepolia Testnet & Smart Contract ───────────────────
# Get free Sepolia ETH: https://sepoliafaucet.com
# Contract already deployed at address below (do not change unless redeploying)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=your_ethereum_sepolia_wallet_private_key_0x...
SEPOLIA_CONTRACT_ADDRESS=0x547007CE756b60A1547dC3D4f827BF9BB9fdeA76

# ── Pinata IPFS — Decentralized File Storage ────────────────────
# Sign up free at https://pinata.cloud
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# ── TimescaleDB (Optional) ──────────────────────────────────────
# Only needed for long-term sensor time-series analytics.
# If not set, backend still works — sensor history uses MongoDB.
# Free cloud: https://www.timescale.com/cloud
# TIMESCALE_URI=postgresql://postgres:password@localhost:5432/SentinelX?sslmode=require
