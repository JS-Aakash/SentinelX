# Server Configuration
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sentinelx?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset Token Config
PASSWORD_RESET_SECRET=your_password_reset_secret_key_min_32_chars_long
PASSWORD_RESET_EXPIRES_IN=1h

# Client Application URL (CORS)
CLIENT_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Service Credentials (e.g., Mailtrap, SendGrid, Gmail)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=SentinelX <noreply@sentinelx.com>

# MQTT Broker Configuration
MQTT_URL=mqtts://your_mqtt_broker_address:8883
MQTT_CLIENT_ID=sentinelx_backend_ingestion

# TimescaleDB / PostgreSQL Configuration
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=SentinelX
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your_timescale_password
TIMESCALE_URI=postgresql://postgres:your_timescale_password@localhost:5432/SentinelX?sslmode=require

# Ethereum Sepolia Testnet & Smart Contract Configuration
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=your_ethereum_sepolia_wallet_private_key_0x...
SEPOLIA_CONTRACT_ADDRESS=0x547007CE756b60A1547dC3D4f827BF9BB9fdeA76

# Pinata IPFS Storage Credentials
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

 